# Runtime mode: "local" keeps the garden in this browser only; "shared" talks to Supabase.
VITE_APP_MODE=local

# Shared mode only. These are compiled into the public bundle; they must be the *publishable* values.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional override; defaults to the single public world id from supabase/migrations/0001_world.sql
VITE_WORLD_ID=00000000-0000-4000-8000-000000000001

# Server-side ONLY (Supabase Edge Function secrets). Never prefix these with VITE_.
# SUPABASE_SERVICE_ROLE_KEY=
# GROWTH_JOB_SECRET=
# WORLD_ENTROPY_SECRET=
